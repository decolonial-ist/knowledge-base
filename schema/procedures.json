{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Процедура",
  "description": "Файл campaigns/C1193/C1193.T0023.yml: процедура кампании C1193 на технике T0023; имя файла = id = кампания.техника (адрес страницы сайта). Поля campaign, technique, actor, tool - словари «номер: название»: человек видит, о чём текст, не открывая другие файлы; источник правды для названий - файлы кампании, техники, актора и инструмента.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "created",
    "modified",
    "version",
    "technique",
    "people",
    "actor",
    "tool",
    "contributors",
    "description"
  ],
  "properties": {
    "type": {
      "const": "procedure"
    },
    "id": {
      "type": "string",
      "pattern": "^C\\d{4}\\.T\\d{4}(\\.\\d{3})?$"
    },
    "campaign": {
      "description": "Кампания процедуры: словарь «номер: название на трёх языках». Название - копия name из файла, на который указывает номер, его ставит scripts/procedure_names.py; руками достаточно написать номер, скрипт допишет остальное.",
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^C\\d{4}$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "uk",
                    "ru"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "uk": {
                      "type": "string"
                    },
                    "ru": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "maxProperties": 1
        },
        {
          "type": "string",
          "pattern": "^C\\d{4}$"
        }
      ]
    },
    "created": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "modified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "technique": {
      "description": "Техника процедуры: словарь «номер: название на трёх языках». Название - копия name из файла, на который указывает номер, его ставит scripts/procedure_names.py; руками достаточно написать номер, скрипт допишет остальное.",
      "anyOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^T\\d{4}(\\.\\d{3})?$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "uk",
                    "ru"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "uk": {
                      "type": "string"
                    },
                    "ru": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "maxProperties": 1
        },
        {
          "type": "string",
          "pattern": "^T\\d{4}(\\.\\d{3})?$"
        }
      ]
    },
    "people": {
      "type": "string",
      "enum": [
        "nokhchi",
        "ukrainians"
      ]
    },
    "actor": {
      "description": "Акторы процедуры, один или несколько; null - актора нет: словарь «номер: название на трёх языках». Название - копия name из файла, на который указывает номер, его ставит scripts/procedure_names.py; руками достаточно написать номер, скрипт допишет остальное.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^G\\d{4}$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "uk",
                    "ru"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "uk": {
                      "type": "string"
                    },
                    "ru": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "string",
          "pattern": "^G\\d{4}$"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G\\d{4}$"
          }
        }
      ]
    },
    "tool": {
      "description": "Инструменты процедуры, один или несколько; null - инструмента нет: словарь «номер: название на трёх языках». Название - копия name из файла, на который указывает номер, его ставит scripts/procedure_names.py; руками достаточно написать номер, скрипт допишет остальное.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^S\\d{4}$": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "uk",
                    "ru"
                  ],
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "uk": {
                      "type": "string"
                    },
                    "ru": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "string",
          "pattern": "^S\\d{4}$"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S\\d{4}$"
          }
        }
      ]
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "uk",
          "ru"
        ],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 0
          },
          "uk": {
            "type": "string",
            "minLength": 0
          },
          "ru": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "uk",
        "ru"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 0
        },
        "uk": {
          "type": "string",
          "minLength": 0
        },
        "ru": {
          "type": "string",
          "minLength": 0
        }
      }
    },
    "campaign_name": {
      "description": "Прежний вид: название отдельным полем. scripts/procedure_names.py переносит его под номер."
    },
    "technique_name": {
      "description": "Прежний вид: название отдельным полем. scripts/procedure_names.py переносит его под номер."
    },
    "actor_name": {
      "description": "Прежний вид: название отдельным полем. scripts/procedure_names.py переносит его под номер."
    },
    "tool_name": {
      "description": "Прежний вид: название отдельным полем. scripts/procedure_names.py переносит его под номер."
    }
  }
}
