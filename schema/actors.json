{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Актор",
  "description": "Файл actors/G0013.yml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "created",
    "modified",
    "version",
    "name",
    "contributors",
    "description"
  ],
  "properties": {
    "type": {
      "const": "actor"
    },
    "id": {
      "type": "string",
      "pattern": "^G\\d{4}$"
    },
    "created": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "modified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en",
        "uk"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 0
        },
        "uk": {
          "type": "string",
          "minLength": 0
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ru",
          "en",
          "uk"
        ],
        "properties": {
          "ru": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 0
          },
          "uk": {
            "type": "string",
            "minLength": 0
          }
        }
      }
    },
    "associated_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ru",
        "en",
        "uk"
      ],
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 0
        },
        "en": {
          "type": "string",
          "minLength": 0
        },
        "uk": {
          "type": "string",
          "minLength": 0
        }
      }
    }
  }
}